# Ambiente local simples para primeira fase
FLASK_ENV=development
SECRET_KEY=petlify-dev-secret
JWT_SECRET_KEY=petlify-dev-jwt-secret
DATABASE_URL=sqlite:///petlify.db
CORS_ORIGINS=http://localhost:3000
BCRYPT_LOG_ROUNDS=12

# O modelo multi-tenant usa store_id para isolar dados por Pet Shop.
# Produção: PostgreSQL externo gratuito (Neon). Copie a URL real no painel do Render.
# DATABASE_URL=postgresql://usuario:senha@host/petlify?sslmode=require&channel_binding=require
# Não publique URLs reais nem copie esse exemplo literalmente.
# Backup/restauração usam a conexão direta, com pooling desativado no painel.
# DATABASE_BACKUP_URL=postgresql://usuario:senha@host/petlify?sslmode=require&channel_binding=require
